# Frontend configuration template. Copy to .env.local (git-ignored).
# EVERY VITE_ variable is compiled into the JavaScript sent to browsers:
# never put a secret (service-role key, SECRET_KEY, tokens, passwords) here.
# The build refuses VITE_ names that look like secrets.

# Backend API base URL, including /api. Leave unset in development (the dev
# server proxies /api to the local backend). For a production build set it to
# the deployed backend, e.g. https://<backend-host>/api — a production build
# refuses a localhost value.
# VITE_API_URL=https://<backend-host>/api

# Development server only (not shipped to browsers):
# DEV_API_PROXY_TARGET=http://localhost:8000
# DEV_ALLOWED_HOSTS=<tunnel-hostname>
