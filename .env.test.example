# Credentials for the Playwright specs that run against a live LOCAL backend.
# Copy to .env.test (git-ignored) or export in the shell. Use local test
# accounts only (e.g. the ones tests/local_stack in the backend creates);
# never production accounts.
TEST_NURSE_EMAIL=
TEST_NURSE_PASSWORD=
TEST_DOCTOR_EMAIL=
TEST_DOCTOR_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_GOVERNMENT_EMAIL=
TEST_GOVERNMENT_PASSWORD=
